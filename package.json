{
  "name": "invoice-processing-devops-system",
  "version": "1.0.0",
  "description": "Invoice processing and auto-entry system with OCR, SQLite storage, CI testing, Docker, and deployment workflow.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "lint": "eslint .",
    "build": "node scripts/build-report.js",
    "ci": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "devops",
    "ocr",
    "invoice",
    "ci-cd",
    "docker"
  ],
